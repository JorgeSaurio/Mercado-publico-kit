# ─── Backend (apps/api) ───────────────────────────────────────────
# Ticket personal entregado por ChileCompra (se solicita con Clave Única en https://www.chilecompra.cl/api/)
# NUNCA lo expongas en el frontend ni en la app móvil.
MP_TICKET=

# Puerto del backend
PORT=3001

# Orígenes permitidos para CORS (separados por coma). Incluye los de Capacitor si compilas la app.
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost

# Límite diario de la API oficial (10.000 por ticket). Dejamos margen de seguridad.
MP_DAILY_LIMIT=9500

# Pausa mínima entre llamadas a la API oficial (ms). La API rechaza peticiones simultáneas.
MP_MIN_INTERVAL_MS=250

# Límite de peticiones por IP de cliente hacia TU backend (por minuto)
CLIENT_RATE_LIMIT_PER_MIN=120

# Consultas NUEVAS (que no salen de caché y gastan cuota del ticket) por IP y hora
CLIENT_MISS_LIMIT_PER_HOUR=150

# Pon en 1 SOLO si hay un proxy delante y el puerto del backend no está expuesto directamente
# TRUST_PROXY=1

# Usar datos de ejemplo en lugar de la API real (útil para desarrollar sin ticket)
MP_MOCK=false

# ─── Frontend (apps/web) ──────────────────────────────────────────
# URL pública del backend. Vacío = mismo origen (/api) usando el proxy de Vite en desarrollo.
VITE_API_URL=
