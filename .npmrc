# ─── Endurecimiento de la cadena de suministro npm ───
# No ejecutar scripts de instalación de dependencias (vector típico de gusanos como Shai-Hulud).
# `npm run`, `npm test` y `npm start` siguen funcionando.
ignore-scripts=true
# Solo instalar versiones publicadas hace al menos 7 días: los paquetes maliciosos suelen detectarse antes.
min-release-age=7
# Guardar versiones exactas al agregar dependencias nuevas.
save-exact=true
audit-level=high
