{
  "name": "@mp/api",
  "version": "1.0.0",
  "description": "Backend que expone la API de Mercado Público de forma segura (ticket oculto, caché, cuota, CORS)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "dev:mock": "MP_MOCK=true tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mp/sdk": "*",
    "compression": "1.8.2",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.4",
    "helmet": "8.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1"
  }
}
